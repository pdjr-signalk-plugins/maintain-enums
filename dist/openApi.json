{
  "openapi": "3.0.3",
  "info": {
    "title": "Maintain enums API",
    "version": "2026.10.23",
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "description": "[maintain-enums](https://github.com/pdjr-signalk-plugins/maintain-enums)\nis a plugin for the\n[Signal K node server](https://github.com/SignalK/signalk-server).\n\nA Signal K server hosting the plugin will present this API under\nthe root https://*server_ip*:*server_port*/plugins/maintain-enums.\n"
  },
  "externalDocs": {
    "description": "Plugin README document",
    "url": "https://github.com/pdjr-signalk-plugins/maintain-enums#readme"
  },
  "paths": {
    "/status": {
      "get": {
        "description": "Get the status of all configured enumerations.\n",
        "responses": {
          "200": {
            "description": "Success.\nThe response body is an object containing a status report\nfor each defined enumeration.\n",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "value": {
                        "description": "Current enumeration (range) value",
                        "type": "string",
                        "example": "Not engaged"
                      },
                      "source": {
                        "description": "Source path",
                        "type": "string",
                        "example": "electrical.switches.bank.12.4.state"
                      },
                      "sourceValue": {
                        "description": "Current source value",
                        "type": "number",
                        "example": 0
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error.\nThe server was unable to service the request."
          }
        }
      }
    }
  }
}
